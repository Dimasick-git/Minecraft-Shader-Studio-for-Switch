{
  "schema": 1,
  "pipeline": "vulkan",
  "note": "Основной пайплайн: Switch-версия Minecraft загружает Vulkan (SPIR-V). См. docs/RESEARCH-2026-07.md",
  "compiler": {
    "name": "shaderc (bgfx-mcbe)",
    "repository": "https://github.com/veka0/bgfx-mcbe",
    "binaries": "https://github.com/veka0/bgfx-mcbe/releases/tag/binaries",
    "role": "bgfx SC -> SPIR-V (профиль spirv), а также ESSL/DXBC/Metal",
    "integration": "external-process, вызывается lazurite"
  },
  "orchestrator": {
    "name": "lazurite",
    "repository": "https://github.com/veka0/lazurite",
    "install": "pip install lazurite",
    "role": "unpack/build/merge material.bin, проектная система",
    "integration": "external-process (mss compile)"
  },
  "headers": {
    "name": "bgfx shader headers",
    "files": ["bgfx_shader.sh", "bgfx_compute.sh"],
    "source": "https://raw.githubusercontent.com/veka0/bgfx-mcbe/master/src/"
  },
  "vanilla_sources": {
    "serialized_materials": "https://github.com/devendrn/newb-shader/releases/download/dev/ (src-materials-<ver>.zip)",
    "shader_code_reference": "https://github.com/veka0/mcbe-shader-codebase",
    "own_dump": "рекомендуется: дамп romfs собственной копии игры (nxdumptool/DBI)"
  },
  "fetch_script": "scripts/fetch_toolchain.py"
}
